# انسخ هذا الملف إلى .env وعدّل القيم

# قاعدة البيانات: فارغة = SQLite محلياً. على الاستضافة ضع رابط Neon (postgresql://...)
DATABASE_URL=

# الحماية عند النشر العام (فارغة = بلا دخول، للتشغيل المحلي فقط)
# ENVIRONMENT=production يرفض التشغيل دون APP_PASSWORD (12 حرفاً فأكثر) و SECRET_KEY
ENVIRONMENT=local
APP_PASSWORD=
SECRET_KEY=
# رمز مهمة الجمع الخارجية (GitHub Actions)
CRON_TOKEN=

# الجمع التلقائي
COLLECT_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=true

# نموذج اللغة للتحليل العميق وكتابة الرسائل
# none = تقييم سريع وقوالب جاهزة بدون أي تكلفة
# anthropic | openai | ollama (محلي بالكامل)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# لـ ollama داخل Docker: http://host.docker.internal:11434
LLM_BASE_URL=

# إرسال التقديم عبر Gmail: فعّل التحقق بخطوتين ثم أنشئ "كلمة مرور التطبيقات"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587) | ssl (465)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# على Render: منافذ SMTP محجوبة، فاستخدم MAIL_TRANSPORT=gas مع سكربت deploy/gmail-relay.gs
MAIL_TRANSPORT=smtp
GAS_URL=
GAS_TOKEN=

# قراءة تنبيهات الوظائف من البريد (لينكدإن، جدارات، بيت)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

CORS_ORIGINS=http://localhost:3000

# اسمح بجلب عناوين داخل شبكتك (للاختبار فقط)
ALLOW_PRIVATE_NETWORK=false
